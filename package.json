{
  "name": "@mekareteriker/opencode-mcp",
  "version": "1.11.2-mekareteriker.0",
  "description": "Hardened fork of opencode-mcp — Windows-compatible directory validation, structured errors, idempotency. Drop-in replacement for the upstream package.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js || true",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "ai",
    "llm",
    "claude",
    "cursor",
    "windsurf",
    "coding-assistant",
    "headless",
    "server",
    "tools",
    "fork"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MekaretEriker/opencode-mcp.git"
  },
  "homepage": "https://github.com/MekaretEriker/opencode-mcp#readme",
  "bugs": {
    "url": "https://github.com/MekaretEriker/opencode-mcp/issues"
  },
  "author": "MekaretEriker (fork) <fmourron69@gmail.com>",
  "contributors": [
    "Alaeddine Messadi (original author)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opencode-ai/sdk": "^1.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
